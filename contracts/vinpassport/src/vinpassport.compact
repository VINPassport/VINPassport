// VINPassport: Digital Circularity Vehicle Passport
// Regulation (EU) 2026/1738, Article 13
//
// SPDX-License-Identifier: Apache-2.0
//
// A vehicle passport is not one number. This contract holds a COMMITMENT per
// (vehicle, field): the write-off category, the accident count, the number of
// keepers, the service and inspection record, the odometer. No field value
// ever reaches the ledger, only a commitment to it, and proofs about it.
//
// EACH FIELD CARRIES ITS OWN INTEGRITY RULE, fixed when the field is created
// and unchangeable afterwards. The rule is stored on the ledger rather than
// passed in per call, so a caller cannot choose the flattering rule at the
// moment they need it, and recreating a field to change it is refused.
//
// THREE RULES EXIST because a rule that could only ever point one way would
// not be a rule: `initialiseField` would not need the argument, and nothing
// would be fixed at creation.
//
// The lifecycle fields only ever rise: mileage, accidents, keepers, services,
// write-off category, the inspection date. The REGULATORY DECLARATIONS do not
// move at all within one document: recycled content, the CO2 figure, the 3R
// percentages are type-approval facts, not events. Declaring them `neverFalls`
// would permit a quiet upward revision of a recycled-content claim, which is
// the direction that flatters. So they are `neverChanges`, and revising one
// means re-anchoring the document, which moves every slot with the root. That
// is the binding in `slotOf` doing the work rather than a second mechanism.
//
// A field that may only fall is supported so that adding one later is a data
// change rather than a contract change.
//
// SCOPE. This is the VEHICLE's record. An electric car's battery is a separate
// regime with its own passport; the panel carries a reference to that passport
// and does not restate its claims.
//
// A PROVEN CLAIM IS RECORDED, the value behind it is not. A proof circuit that
// only asserted would leave nothing for a verifier to read afterwards: the
// transaction's success is the proof, but nothing would index it by vehicle.
// So a successful proof writes a Claim, naming which vehicle, which field,
// which direction and which bound, and never the value that satisfied it.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---------------------------------------------------------------- integrity rules

// Which way a field is allowed to move over its lifetime.
export enum Rule {
  neverFalls,   // the lifecycle fields: mileage, accidents, keepers, services
  neverRises,   // reserved: no panel field uses this yet, by design
  neverChanges  // the regulatory declarations, fixed for a document version
}

// ---------------------------------------------------------------- disclosure tiers

// Which view of a vehicle a grant entitles its holder to (D26 in
// docs/DECISIONS.md). There is no `public` member on purpose: the public view
// needs no grant, and Euro 7 passport data may not be put behind one, because
// reading it may require nothing beyond the VIN (Reg. (EU) 2025/1707, Annex V
// 4.2.3). A grant for it could only ever be meaningless or unlawful.
export enum Tier {
  trade,      // dealer, recycler, insurer, lender: the history, every value exact
  authority   // registry, police, notified body: every field, and the VIN
}

// ---------------------------------------------------------------- claims

// What a verifier reads after the fact.
//
// Everything here is already public: the bound and the field are call
// arguments, and the commitment is on the ledger. The VALUE that satisfied the
// claim is absent, which is the whole point.
//
// `commitment` is what the claim was proven against, so a claim cannot outlive
// the value it was made about. Record a new value for the field and the
// commitment moves on; a verifier comparing this against the current
// fieldCommitment sees the claim is stale rather than mistaking it for current.
//
// `slot` is carried so a verifier can find the current commitment by direct
// lookup. Deriving it needs persistentHash, which a plain browser page has no
// way to compute; see D19.
export struct Claim {
  slot: Bytes<32>,
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  commitment: Bytes<32>,
  bound: Uint<64>,
  atMost: Boolean
}

// What a verifier reads after a claim about one field against another.
//
// Some of what a buyer asks is not a field against a number, it is a field
// against another field. "Serviced within the last 15 000 km" is the odometer
// against the reading taken at the last service. "Every recall has been done"
// is recalls issued against recalls completed. Neither can be put as a public
// bound, because the thing being compared to is itself hidden, and asking the
// holder to publish one of the two in order to prove a fact about the pair
// would give away exactly what this contract exists to keep.
//
// `slack` is public and is the whole claim: it is how far apart the two values
// are allowed to be. Slack zero says the low field has caught up with the high
// one, which is what "every recall has been done" means.
export struct RelClaim {
  slotHigh: Bytes<32>,
  slotLow: Bytes<32>,
  vinHash: Bytes<32>,
  fieldKeyHigh: Bytes<32>,
  fieldKeyLow: Bytes<32>,
  commitmentHigh: Bytes<32>,
  commitmentLow: Bytes<32>,
  slack: Uint<64>
}

// ---------------------------------------------------------------- events (D29)

// What every state change announces: WHICH record changed, and HOW.
//
// Carried by the standard `Misc` event. Its 32-byte `name` is the subject,
// the vehicle's VIN hash (for governance, the proposal key), and its payload
// is this record: the schema and the kind of change, both constants. The
// contract that emitted it comes with the event, and the circuit that ran
// with the call, so a reader filters one vehicle's history by `name` and reads
// the details from the ledger at that block.
//
// WHY SO LITTLE. Measured on 8 November 2026 (DECISIONS D29): every variable
// byte an event carries is repacked byte by byte in-circuit. A six-field
// payload multiplied a writing circuit's size about ten times and its prover
// key from 11 MB to 180 MB; constants cost nothing, and one value in the name
// slot costs about a third of one in the payload. So the subject goes in the
// name and everything else is either constant or already on the ledger.
//
// THE RULE: an event carries only what the ledger state already shows. The
// subject is a ledger key (`passports`, or `registrarApprovals`); the kind is
// a constant. No writer or grantee identity, no value, no salt.
export struct PassportEvent {
  schema: Bytes<32>,
  kind: Bytes<32>
}

// ---------------------------------------------------------------- public ledger

// vinHash -> content root anchoring the canonical passport payload
export ledger passports: Map<Bytes<32>, Bytes<32>>;

// vinHash -> registering authority, so every claim is attributable
export ledger registrar: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> commitment to that field's current value
export ledger fieldCommitment: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> the integrity rule, written once at creation
export ledger fieldRule: Map<Bytes<32>, Rule>;

// claimKey -> the claim that was proven. Re-proving the same claim against the
// same value is idempotent: it writes the same key twice.
export ledger claims: Map<Bytes<32>, Claim>;

// relClaimKey -> a claim comparing TWO of a vehicle's fields, neither value
// published. Kept in its own map rather than widened into Claim, so a reader
// that understands only single-field claims cannot misread one of these as
// a claim about one field.
export ledger relClaims: Map<Bytes<32>, RelClaim>;

// THERE IS DELIBERATELY NO GLOBAL UPDATE COUNTER HERE.
//
// There was one, and it cost more than it was worth. A Counter is a single
// cell and it is always populated, so every circuit that touched it wrote an
// already-populated cell. The ledger refuses such a write when any later
// intent follows it in the same transaction, which meant initialiseField
// closed its transaction: a vehicle carrying sixty fields cost sixty
// transactions, one per field.
//
// Without it, initialiseField writes three fresh Map keys and nothing else,
// so initialisations batch exactly as registration and the proof circuits
// already did. recordField still closes its transaction, because it genuinely
// overwrites a commitment, and that is the right shape: registration is a
// bulk event, and later updates arrive one at a time anyway.
//
// Nothing needed the number. It was read only for display, and an indexer can
// count field writes from the events without the contract keeping a tally
// that costs every caller a transaction.

// WHO MAY REGISTER A VEHICLE. Set at deployment, and changed afterwards only
// by the registrars themselves: two current registrars approving the same
// change, each in a transaction of their own (approveRegistrarChange, D32).
// Every change is announced, so the list a verifier reads is the deployed list
// plus a public history of who approved what. Four slots at deployment because
// the panel is a national-registry pilot; unused slots repeat an entry, since a
// set keeps one copy and no secret hashes to an unused value by accident.
export ledger allowedRegistrars: Set<Bytes<32>>;

// WHO MAY WRITE TO ONE PARTICULAR VEHICLE, decided after deployment by the
// registrar that registered it. A vehicle outlives the moment it was built: it
// reaches a dealership, changes keeper, is serviced by someone the
// manufacturer never names at the factory. None of that can be written by a
// set fixed at deployment, and a contract that pretends otherwise just means
// the history is kept somewhere else.
//
// Flat rather than a set per vehicle: membership is keyed on
// `writerKeyOf(vinHash, writerId)`, so one set holds every (vehicle, writer)
// pair and no key can be confused with a slot or a claim.
//
// The chain of accountability is three links and all three are public: the
// registrars fixed at deployment, the one that registered this vehicle, and
// the writers it admitted. A writer cannot admit another writer.
export ledger writers: Set<Bytes<32>>;

// slot -> the identity that last wrote that field. A value is not just a
// commitment any more; it carries who put it there, which is the difference
// between a service record and a claim about one.
//
// THIS IS DELIBERATELY PUBLIC, and it is new information: before, every field
// on a vehicle was written by the registrar already named in `registrar`, so
// there was nothing to say. With more than one possible writer, which of them
// wrote a field is exactly what a reader needs and exactly what the ledger now
// reveals. The value stays hidden. Who stood behind it does not.
export ledger fieldWriter: Map<Bytes<32>, Bytes<32>>;

// WHO HAS BEEN GIVEN WHICH VIEW OF ONE VEHICLE (D26). The disclosure itself
// happens off chain: the holder hands a bundle over and the reader checks each
// value against `fieldCommitment`. What this records is the entitlement, so
// that who was given the trade or the authority view of a vehicle, and on
// whose authority, sits on the same public record as who wrote to it. When it
// was given is the transaction's place in the chain.
//
// IT RECALLS NOTHING. Revoking removes the entitlement from here; values
// already handed over stay known to whoever holds them. A grant makes a
// disclosure auditable, not reversible.
//
// Flat like `writers`: keyed on `grantKeyOf(vinHash, granteeId)`, so one map
// holds every (vehicle, grantee) pair and no key can be confused with a slot,
// a claim or a writer.
export ledger grants: Map<Bytes<32>, Tier>;

// WHO DECIDES WHO REGISTERS (D32). The registrar set started as the list the
// contract was deployed with, and it changes only when two current
// registrars approve the same change, each in a transaction of their own,
// with their own secret: nobody hands a secret to anyone. The maintenance
// committee (D28) controls the code; the registrars control their own
// membership. Two powers, two sets of hands.
//
// proposal -> approvals so far, for a change not yet carried out.
export ledger registrarApprovals: Map<Bytes<32>, Uint<8>>;
// hash(proposal, approver): who has approved what, so nobody approves twice.
export ledger registrarBallots: Set<Bytes<32>>;
// Moves on every change carried out. A proposal names the epoch it was made
// in, so approvals given before a change cannot be reused after it.
export ledger registrarEpoch: Counter;

constructor(registrars: Vector<4, Bytes<32>>) {
  for (const id of registrars) {
    allowedRegistrars.insert(disclose(id));
  }
}

// ---------------------------------------------------------------- private state

// The value being written. Never disclosed.
witness newValue(): Uint<64>;

// The current value and its salt, so the caller can open the stored
// commitment in-circuit without revealing either.
witness previousValue(): Uint<64>;
witness previousSalt(): Bytes<32>;

// Fresh salt for the new commitment, so two vehicles holding the same value
// do not produce the same commitment.
witness newSalt(): Bytes<32>;

// The SECOND field's current value and salt, for a claim that compares two of
// a vehicle's fields. Neither is disclosed, exactly as the first pair is not.
witness otherValue(): Uint<64>;
witness otherSalt(): Bytes<32>;

// The registrar's authority secret. Never disclosed: only the identity derived
// from it reaches the ledger, and only when a vehicle is registered.
witness registrarSecret(): Bytes<32>;

// ---------------------------------------------------------------- helpers

// Where a vehicle's field lives on the ledger. Domain-separated so a slot key
// can never collide with any other hash this contract stores.
//
// THE SLOT BINDS THE DOCUMENT, not just the vehicle and the field. The content
// root is the hash of the canonical passport payload, so a field commitment is
// by construction about one (vehicle, field, document) and not merely about a
// vehicle. That is what makes the binding checkable by someone who was handed
// the document: recompute this with the root you hold, and a claim about a
// different document gives a different slot. Before, a claim named the vehicle
// but nothing tied it to the payload a verifier was reading.
//
// The root is never taken as an argument. Every caller reads it from
// `passports`, so there is no version for a caller to choose.
//
// Exported for that off-chain check. The tag is v2 because the derivation
// changed: slots written under the previous scheme are a different set, which a
// fresh deployment makes moot.
//
// CONSEQUENCE, stated rather than discovered later: a passport's root is fixed
// when it is registered, so this is stable today. If revising a document is
// ever supported, every slot moves with the root and the earlier field history
// belongs to the earlier document. That is the honest meaning of binding, not
// a defect of it.
export circuit slotOf(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  contentRoot: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "vinpassport:field:v2"), vinHash, fieldKey, contentRoot]
  );
}

// A registrar's public identity, derived from a secret only that registrar
// holds. Identity is DERIVED, never supplied: a caller proves they hold the
// secret rather than naming who they are, so the name on a passport is a
// consequence of the proof instead of an argument to it.
//
// Domain-separated on its own tag, so a registrar identity can never collide
// with a field slot or a claim key.
export circuit registrarIdOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "vinpassport:registrar:v1"), secret]
  );
}

// Where a (vehicle, writer) pair lives in `writers`. Domain-separated on its
// own tag, so an authorisation can never be confused with a field slot, a
// claim key or a registrar identity.
//
// Exported because the party being authorised needs to compute it to check
// they really were, and a verifier needs it to ask whether a given identity
// may write to a given vehicle. Both are public questions about public state.
export circuit writerKeyOf(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "vinpassport:writer:v1"), vinHash, writerId]
  );
}

// Where a (vehicle, grantee) pair lives in `grants`. Domain-separated on its
// own tag, like `writerKeyOf`, so a grant can never be read as a writer.
//
// Exported so a reader handed a bundle can ask whether its audience was
// granted that view, which is a public question about public state.
export circuit grantKeyOf(
  vinHash: Bytes<32>,
  granteeId: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "vinpassport:grant:v1"), vinHash, granteeId]
  );
}

// A two-field claim's public name. Binds both slots, both commitments and the
// slack, so the claim dies when either value moves, not just the first.
circuit relClaimKey(
  tag: Bytes<32>,
  slotHigh: Bytes<32>,
  slotLow: Bytes<32>,
  slack: Uint<64>,
  commitmentHigh: Bytes<32>,
  commitmentLow: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<6, Bytes<32>>>(
    [tag, slotHigh, slotLow, slack as Bytes<32>, commitmentHigh, commitmentLow]
  );
}

// A claim's public name. Binds the direction, the slot, the bound AND the
// commitment, so proving "at most 0" and "at least 0" are different claims,
// and neither survives the value being updated.
circuit claimKey(
  tag: Bytes<32>,
  slot: Bytes<32>,
  bound: Uint<64>,
  commitment: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [tag, slot, bound as Bytes<32>, commitment]
  );
}

// Who the caller is, checked against everyone entitled to write this vehicle,
// and returned so the write can be stamped with it.
//
// Both sides of the test are evaluated every time, as a circuit must: there is
// no short cut here and no branch for an observer to time. The registrar
// itself is never in `writers`, so the comparison against `registrar` is not
// redundant with the membership test.
//
// The identity is disclosed because the ledger records it. The secret behind
// it is not, and never leaves the circuit.
circuit writerFor(vinHash: Bytes<32>): Bytes<32> {
  const id = disclose(registrarIdOf(registrarSecret()));
  // A registrar the others removed (D32) keeps its name on what it
  // registered and loses the power to write it. Writers it admitted keep
  // theirs: they are other parties, admitted while it was entitled to.
  assert(
    (registrar.lookup(vinHash) == id && allowedRegistrars.member(id))
      || writers.member(writerKeyOf(vinHash, id)),
    "not the registrar for this vehicle, and not authorised to write it"
  );
  return id;
}

// The caller, proven to be this vehicle's registrar and still a registrar.
// The identity is disclosed because the ledger already names the vehicle's
// registrar; the secret behind it never leaves the circuit.
circuit actingRegistrar(vinHash: Bytes<32>): Bytes<32> {
  const id = disclose(registrarIdOf(registrarSecret()));
  assert(registrar.lookup(vinHash) == id, "not the registrar for this vehicle");
  assert(allowedRegistrars.member(id), "no longer an authorised registrar");
  return id;
}

// Announce a state change (D29): its kind, a constant at every call site, and
// its subject. See PassportEvent.
circuit announce(kind: Bytes<32>, subject: Bytes<32>): [] {
  emit(Misc {
    name: subject,
    payload: serialize<PassportEvent, 256>(PassportEvent { schema: pad(32, "vinpassport.v1"), kind: kind })
  });
}

// ---------------------------------------------------------------- circuits

// Register a vehicle passport. The content root commits to the canonical
// 32-field payload held off-chain; only its hash is public.
export circuit registerPassport(
  vinHash: Bytes<32>,
  contentRoot: Bytes<32>
): [] {
  assert(!passports.member(disclose(vinHash)), "passport already registered");

  // Disclosed because the ledger records WHICH authority registered the
  // vehicle, so a later claim is attributable. The secret behind it is not
  // disclosed and never leaves the circuit.
  const id = disclose(registrarIdOf(registrarSecret()));
  assert(allowedRegistrars.member(id), "not an authorised registrar");

  passports.insert(disclose(vinHash), disclose(contentRoot));
  registrar.insert(disclose(vinHash), id);
  announce(pad(32, "registered"), disclose(vinHash));
}

// Let another identity write this vehicle's fields. Only the registrar that
// registered the vehicle may do this, and only for that vehicle.
//
// `writerId` is the identity the other party derived from their own secret and
// handed over out of band. Nothing here can check it was derived that way, and
// nothing needs to: an identity nobody holds the secret for is an
// authorisation that can never be used, which costs one transaction and harms
// no one.
//
// AUTHORISING IS NOT THE WHOLE HANDOVER. Updating a field also requires the
// current value and its salt, and those are private state the registrar holds.
// A dealership that has been authorised but not handed the opening can create
// fields that do not exist yet; to update one it must be given the value it is
// updating, which is a disclosure the registrar makes deliberately and
// separately. The contract cannot do that part and does not pretend to.
export circuit authoriseWriter(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  const id = actingRegistrar(disclose(vinHash));
  assert(id != disclose(writerId), "the registrar already writes this vehicle");
  const key = writerKeyOf(disclose(vinHash), disclose(writerId));
  writers.insert(key);
  announce(pad(32, "writerAuthorised"), disclose(vinHash));
}

// Take that permission away. A dealer relationship ends, a garage closes, a
// secret is suspected lost.
//
// What this does NOT do is unwrite anything. Fields that identity already
// wrote stay written and stay stamped with it, which is the honest behaviour:
// the record says who wrote what at the time, and withdrawing an authorisation
// afterwards cannot make that untrue.
export circuit withdrawWriter(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  const id = actingRegistrar(disclose(vinHash));
  const key = writerKeyOf(disclose(vinHash), disclose(writerId));
  assert(writers.member(key), "not a writer for this vehicle");
  writers.remove(key);
  announce(pad(32, "writerWithdrawn"), disclose(vinHash));
}

// Record that `granteeId` is entitled to the trade or the authority view of
// this vehicle. Only the registrar that registered it may, the same authority
// that admits writers, so one party answers for both who may write and who may
// read beyond the public view.
//
// Granting again replaces the tier, so a dealer can be moved to the authority
// view, or back, without a revoke in between. Each change is its own
// transaction, so the history of a grant is as public as the grant.
//
// A grant is not permission to write. `writerFor` never reads `grants`.
//
// THE KEEPER IS NOT ASKED. The contract holds no keeper identity, so the
// registrar decides; D26 states keeper consent as an open gap.
export circuit grantDisclosure(
  vinHash: Bytes<32>,
  granteeId: Bytes<32>,
  tier: Tier
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  const id = actingRegistrar(disclose(vinHash));
  const key = grantKeyOf(disclose(vinHash), disclose(granteeId));
  grants.insert(key, disclose(tier));
  announce(pad(32, "granted"), disclose(vinHash));
}

// Take a grant away. What was handed over while it stood stays handed over;
// see `grants`.
export circuit revokeDisclosure(
  vinHash: Bytes<32>,
  granteeId: Bytes<32>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  const id = actingRegistrar(disclose(vinHash));
  const key = grantKeyOf(disclose(vinHash), disclose(granteeId));
  assert(grants.member(key), "no grant for this identity on this vehicle");
  grants.remove(key);
  announce(pad(32, "revoked"), disclose(vinHash));
}

// Create a field and fix its integrity rule for good. The opening value is a
// witness, so the field exists on chain without its value being published.
export circuit initialiseField(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  rule: Rule
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  // The registrar for this vehicle, or an identity it authorised. The caller
  // proves they hold the secret behind one of those identities; the identity
  // itself is recorded against the field below.
  const writer = writerFor(disclose(vinHash));

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(!fieldCommitment.member(slot), "field already initialised");

  const value = newValue();
  const commitment = persistentCommit<Uint<64>>(value, newSalt());
  fieldCommitment.insert(slot, commitment);
  fieldRule.insert(slot, disclose(rule));
  fieldWriter.insert(slot, writer);
  announce(pad(32, "fieldInitialised"), disclose(vinHash));
}

// Write a new value for a field, proving in-circuit that the caller knows the
// current one and that the change respects the rule fixed at creation.
// Neither value is disclosed.
export circuit recordField(vinHash: Bytes<32>, fieldKey: Bytes<32>): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  // Same gate as creation: history is written by the registrar for this
  // vehicle or by someone it authorised. Proving a claim about a field stays
  // open to anyone who can open its commitment, which is a separate right and
  // deliberately ungated.
  const writer = writerFor(disclose(vinHash));

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const prev = previousValue();
  const prevSalt = previousSalt();

  // The caller must genuinely know the current value: its commitment has to
  // reproduce what the ledger already holds.
  assert(
    persistentCommit<Uint<64>>(prev, prevSalt) == fieldCommitment.lookup(slot),
    "previous value does not open the stored commitment"
  );

  const current = newValue();
  const rule = fieldRule.lookup(slot);

  // All three guards are evaluated every time; each is vacuous under the
  // other rules. Written this way rather than as a branch so that the failure
  // a caller sees names what they violated.
  assert(rule != Rule.neverFalls || current >= prev, "value decreased");
  assert(rule != Rule.neverRises || current <= prev, "value increased");
  assert(rule != Rule.neverChanges || current == prev, "value changed");

  const commitment = persistentCommit<Uint<64>>(current, newSalt());
  fieldCommitment.insert(slot, commitment);
  fieldWriter.insert(slot, writer);
  announce(pad(32, "fieldRecorded"), disclose(vinHash));
}

// Prove the hidden value is at or below a public bound.
// "Under 150 000 km." "Never had a reported accident" is this with bound 0.
export circuit proveFieldAtMost(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  // Reading the root means the passport has to exist. Proving a claim about an
  // unregistered vehicle was never possible, because no field could have been
  // initialised for one, but it now refuses for the reason a caller expects
  // rather than for a reason about slots.
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value <= disclose(bound), "value above the claimed bound");

  // Only reached when the claim holds: a failed proof aborts above and writes
  // nothing.
  const key = claimKey(pad(32, "vinpassport:claim:atmost:v1"), slot, disclose(bound), commitment);
  claims.insert(
    key,
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: true
    }
  );
  // No actor: anyone who can open the commitment may prove a claim about it,
  // and the ledger records no prover.
  announce(pad(32, "claimAtMost"), disclose(vinHash));
}

// Prove the hidden value is at or above a public bound.
// The mirror of proveFieldAtMost: a floor rather than a ceiling.
export circuit proveFieldAtLeast(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value >= disclose(bound), "value below the claimed bound");

  const key = claimKey(pad(32, "vinpassport:claim:atleast:v1"), slot, disclose(bound), commitment);
  claims.insert(
    key,
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: false
    }
  );
  announce(pad(32, "claimAtLeast"), disclose(vinHash));
}

// Prove one hidden field is no more than `slack` above another hidden field.
//
// "Serviced within the last 15 000 km": high is the odometer, low is the
// reading at the last service, slack is 15 000. "Every recall has been done":
// high is recalls issued, low is recalls completed, slack is 0. In both cases
// the two readings stay hidden and only their permitted separation is public.
//
// Both commitments must be opened, so the caller has to know BOTH values. That
// is the same bar as recordField sets for one field, applied twice: a claim
// about a pair needs the openings for the pair.
//
// The two fields must differ. Comparing a field with itself would prove
// nothing at all while looking like a claim, and a claim that cannot fail is
// worse than no claim, because a reader cannot tell the difference.
export circuit proveFieldAtMostField(
  vinHash: Bytes<32>,
  fieldKeyHigh: Bytes<32>,
  fieldKeyLow: Bytes<32>,
  slack: Uint<64>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const root = passports.lookup(disclose(vinHash));
  const slotHigh = slotOf(disclose(vinHash), disclose(fieldKeyHigh), root);
  const slotLow = slotOf(disclose(vinHash), disclose(fieldKeyLow), root);

  assert(slotHigh != slotLow, "a field compared with itself proves nothing");
  assert(fieldCommitment.member(slotHigh), "first field not initialised");
  assert(fieldCommitment.member(slotLow), "second field not initialised");

  const high = previousValue();
  const highSalt = previousSalt();
  const low = otherValue();
  const lowSalt = otherSalt();

  const commitmentHigh = fieldCommitment.lookup(slotHigh);
  const commitmentLow = fieldCommitment.lookup(slotLow);

  assert(
    persistentCommit<Uint<64>>(high, highSalt) == commitmentHigh,
    "first value does not open the stored commitment"
  );
  assert(
    persistentCommit<Uint<64>>(low, lowSalt) == commitmentLow,
    "second value does not open the stored commitment"
  );

  // high <= low + slack. Addition widens, so the sum cannot wrap and let an
  // enormous slack make a false claim provable.
  assert(
    (high as Uint<65>) <= (low as Uint<65>) + (disclose(slack) as Uint<65>),
    "the two values are further apart than the claimed slack"
  );

  const key = relClaimKey(
    pad(32, "vinpassport:relclaim:v1"),
    slotHigh, slotLow, disclose(slack), commitmentHigh, commitmentLow
  );
  announce(pad(32, "relClaim"), disclose(vinHash));
  relClaims.insert(
    key,
    RelClaim {
      slotHigh: slotHigh,
      slotLow: slotLow,
      vinHash: disclose(vinHash),
      fieldKeyHigh: disclose(fieldKeyHigh),
      fieldKeyLow: disclose(fieldKeyLow),
      commitmentHigh: commitmentHigh,
      commitmentLow: commitmentLow,
      slack: disclose(slack)
    }
  );
}

// ---------------------------------------------------------------- read circuits

// Questions another contract can ask this one in the same transaction, and
// that a successor contract can use to carry a vehicle's record forward. Every
// answer is already public in the ledger; these circuits only make it callable.
// None of them writes, and none of them takes a witness.
//
// "Current" means against the field's commitment as it stands now. A claim
// key binds the commitment it was proven against, so recomputing the key from
// the current commitment and finding it in `claims` is exactly "a claim that
// still holds". A claim about a value since overwritten is not found.

// Is this vehicle registered?
export circuit isRegistered(vinHash: Bytes<32>): Boolean {
  return passports.member(disclose(vinHash));
}

// The authority that registered it. Refuses for an unregistered vehicle.
export circuit registrarOf(vinHash: Bytes<32>): Bytes<32> {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  return registrar.lookup(disclose(vinHash));
}

// The commitment to a field's current value. A successor contract given the
// value and its salt checks persistentCommit(value, salt) against this, which
// is how a record moves to a new contract without anyone trusting a copy.
export circuit commitmentOf(vinHash: Bytes<32>, fieldKey: Bytes<32>): Bytes<32> {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");
  return fieldCommitment.lookup(slot);
}

// Does the ledger hold a current "at most `bound`" claim for this field?
// False, never a refusal, for an unknown vehicle or field, so a caller can
// branch on the answer.
export circuit holdsAtMost(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): Boolean {
  return holdsClaim(pad(32, "vinpassport:claim:atmost:v1"), vinHash, fieldKey, bound);
}

// The mirror: a current "at least `bound`" claim.
export circuit holdsAtLeast(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): Boolean {
  return holdsClaim(pad(32, "vinpassport:claim:atleast:v1"), vinHash, fieldKey, bound);
}

// Has this vehicle's registrar given `granteeId` exactly this view?
export circuit holdsGrant(
  vinHash: Bytes<32>,
  granteeId: Bytes<32>,
  tier: Tier
): Boolean {
  const key = grantKeyOf(disclose(vinHash), disclose(granteeId));
  if (!grants.member(key)) {
    return false;
  }
  return grants.lookup(key) == disclose(tier);
}

circuit holdsClaim(
  tag: Bytes<32>,
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): Boolean {
  if (!passports.member(disclose(vinHash))) {
    return false;
  }
  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  if (!fieldCommitment.member(slot)) {
    return false;
  }
  return claims.member(claimKey(tag, slot, disclose(bound), fieldCommitment.lookup(slot)));
}

// Is this identity a registrar now? For a contract that wants to trust what a
// registrar says, and for a reader checking the set after a change (D32).
export circuit isRegistrar(registrarId: Bytes<32>): Boolean {
  return allowedRegistrars.member(disclose(registrarId));
}

// ---------------------------------------------------------------- registrar governance (D32)

// A change to the registrar set, named for the epoch it was proposed in.
// Exported so a registrar can see which proposal it is approving, and a
// reader which one an approval counted towards.
export circuit proposalKeyOf(add: Boolean, registrarId: Bytes<32>, epoch: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "vinpassport:registrar-change:v1"),
    add ? pad(32, "add") : pad(32, "remove"),
    registrarId,
    epoch as Bytes<32>
  ]);
}

// Approve adding (`add` true) or removing a registrar. The caller proves it is
// a current registrar, as everywhere else, by the secret behind its identity.
// The second distinct approval of the same change, in the same epoch, carries
// it out; the epoch then moves, and every approval given before it is spent.
//
// A removal may not leave fewer than two registrars, or the set could never
// change again. Removing a registrar does not touch what it registered: see
// writerFor and actingRegistrar.
export circuit approveRegistrarChange(add: Boolean, registrarId: Bytes<32>): [] {
  const approver = disclose(registrarIdOf(registrarSecret()));
  assert(allowedRegistrars.member(approver), "not an authorised registrar");

  const adding = disclose(add);
  const id = disclose(registrarId);
  assert(!adding || !allowedRegistrars.member(id), "already a registrar");
  assert(adding || allowedRegistrars.member(id), "not a registrar");
  assert(adding || allowedRegistrars.size() > 2, "removing it would leave fewer than two registrars");

  const proposal = proposalKeyOf(adding, id, registrarEpoch.read());
  const ballot = persistentHash<Vector<3, Bytes<32>>>([pad(32, "vinpassport:ballot:v1"), proposal, approver]);
  assert(!registrarBallots.member(ballot), "already approved by this registrar");
  registrarBallots.insert(ballot);

  const before = registrarApprovals.member(proposal) ? registrarApprovals.lookup(proposal) : 0 as Uint<8>;
  const count = (before + 1) as Uint<8>;
  announce(pad(32, "registrarApproval"), proposal);

  if (count >= 2) {
    if (adding) {
      allowedRegistrars.insert(id);
      announce(pad(32, "registrarAdded"), proposal);
    } else {
      allowedRegistrars.remove(id);
      announce(pad(32, "registrarRemoved"), proposal);
    }
    if (registrarApprovals.member(proposal)) {
      registrarApprovals.remove(proposal);
    }
    registrarEpoch.increment(1);
  } else {
    registrarApprovals.insert(proposal, count);
  }
}
