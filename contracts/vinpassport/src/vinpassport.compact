// VINPassport: Digital Circularity Vehicle Passport
// Regulation (EU) 2026/1738, Article 13
//
// SPDX-License-Identifier: Apache-2.0
//
// A vehicle passport is not one number. This contract holds a COMMITMENT per
// (vehicle, field): the write-off category, the accident count, the number of
// keepers, the service and inspection record, the odometer. No field value
// ever reaches the ledger, only a commitment to it, and proofs about it.
//
// EACH FIELD CARRIES ITS OWN INTEGRITY RULE, fixed when the field is created
// and unchangeable afterwards. The rule is stored on the ledger rather than
// passed in per call, so a caller cannot choose the flattering rule at the
// moment they need it, and recreating a field to change it is refused.
//
// THREE RULES EXIST because a rule that could only ever point one way would
// not be a rule: `initialiseField` would not need the argument, and nothing
// would be fixed at creation.
//
// The lifecycle fields only ever rise: mileage, accidents, keepers, services,
// write-off category, the inspection date. The REGULATORY DECLARATIONS do not
// move at all within one document: recycled content, the CO2 figure, the 3R
// percentages are type-approval facts, not events. Declaring them `neverFalls`
// would permit a quiet upward revision of a recycled-content claim, which is
// the direction that flatters. So they are `neverChanges`, and revising one
// means re-anchoring the document, which moves every slot with the root. That
// is the binding in `slotOf` doing the work rather than a second mechanism.
//
// A field that may only fall is supported so that adding one later is a data
// change rather than a contract change.
//
// SCOPE. This is the VEHICLE's record. An electric car's battery is a separate
// regime with its own passport; the panel carries a reference to that passport
// and does not restate its claims.
//
// A PROVEN CLAIM IS RECORDED, the value behind it is not. A proof circuit that
// only asserted would leave nothing for a verifier to read afterwards: the
// transaction's success is the proof, but nothing would index it by vehicle.
// So a successful proof writes a Claim, naming which vehicle, which field,
// which direction and which bound, and never the value that satisfied it.

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ---------------------------------------------------------------- integrity rules

// Which way a field is allowed to move over its lifetime.
export enum Rule {
  neverFalls,   // the lifecycle fields: mileage, accidents, keepers, services
  neverRises,   // reserved: no panel field uses this yet, by design
  neverChanges  // the regulatory declarations, fixed for a document version
}

// ---------------------------------------------------------------- claims

// What a verifier reads after the fact.
//
// Everything here is already public: the bound and the field are call
// arguments, and the commitment is on the ledger. The VALUE that satisfied the
// claim is absent, which is the whole point.
//
// `commitment` is what the claim was proven against, so a claim cannot outlive
// the value it was made about. Record a new value for the field and the
// commitment moves on; a verifier comparing this against the current
// fieldCommitment sees the claim is stale rather than mistaking it for current.
//
// `slot` is carried so a verifier can find the current commitment by direct
// lookup. Deriving it needs persistentHash, which a plain browser page has no
// way to compute; see D19.
export struct Claim {
  slot: Bytes<32>,
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  commitment: Bytes<32>,
  bound: Uint<64>,
  atMost: Boolean
}

// ---------------------------------------------------------------- public ledger

// vinHash -> content root anchoring the canonical passport payload
export ledger passports: Map<Bytes<32>, Bytes<32>>;

// vinHash -> registering authority, so every claim is attributable
export ledger registrar: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> commitment to that field's current value
export ledger fieldCommitment: Map<Bytes<32>, Bytes<32>>;

// slot(vinHash, fieldKey) -> the integrity rule, written once at creation
export ledger fieldRule: Map<Bytes<32>, Rule>;

// claimKey -> the claim that was proven. Re-proving the same claim against the
// same value is idempotent: it writes the same key twice.
export ledger claims: Map<Bytes<32>, Claim>;

// How many field updates have been recorded across every vehicle
export ledger updateCount: Counter;

// WHO MAY REGISTER A VEHICLE, fixed at deployment and never afterwards. There
// is no circuit that adds to this set, so the list a verifier reads is the
// list the contract was deployed with. Four slots because the panel is a
// national-registry pilot; unused slots repeat an entry, since a set keeps one
// copy and no secret hashes to an unused value by accident.
export ledger allowedRegistrars: Set<Bytes<32>>;

// WHO MAY WRITE TO ONE PARTICULAR VEHICLE, decided after deployment by the
// registrar that registered it. A vehicle outlives the moment it was built: it
// reaches a dealership, changes keeper, is serviced by someone the
// manufacturer never names at the factory. None of that can be written by a
// set fixed at deployment, and a contract that pretends otherwise just means
// the history is kept somewhere else.
//
// Flat rather than a set per vehicle: membership is keyed on
// `writerKeyOf(vinHash, writerId)`, so one set holds every (vehicle, writer)
// pair and no key can be confused with a slot or a claim.
//
// The chain of accountability is three links and all three are public: the
// registrars fixed at deployment, the one that registered this vehicle, and
// the writers it admitted. A writer cannot admit another writer.
export ledger writers: Set<Bytes<32>>;

// slot -> the identity that last wrote that field. A value is not just a
// commitment any more; it carries who put it there, which is the difference
// between a service record and a claim about one.
//
// THIS IS DELIBERATELY PUBLIC, and it is new information: before, every field
// on a vehicle was written by the registrar already named in `registrar`, so
// there was nothing to say. With more than one possible writer, which of them
// wrote a field is exactly what a reader needs and exactly what the ledger now
// reveals. The value stays hidden. Who stood behind it does not.
export ledger fieldWriter: Map<Bytes<32>, Bytes<32>>;

constructor(registrars: Vector<4, Bytes<32>>) {
  for (const id of registrars) {
    allowedRegistrars.insert(disclose(id));
  }
}

// ---------------------------------------------------------------- private state

// The value being written. Never disclosed.
witness newValue(): Uint<64>;

// The current value and its salt, so the caller can open the stored
// commitment in-circuit without revealing either.
witness previousValue(): Uint<64>;
witness previousSalt(): Bytes<32>;

// Fresh salt for the new commitment, so two vehicles holding the same value
// do not produce the same commitment.
witness newSalt(): Bytes<32>;

// The registrar's authority secret. Never disclosed: only the identity derived
// from it reaches the ledger, and only when a vehicle is registered.
witness registrarSecret(): Bytes<32>;

// ---------------------------------------------------------------- helpers

// Where a vehicle's field lives on the ledger. Domain-separated so a slot key
// can never collide with any other hash this contract stores.
//
// THE SLOT BINDS THE DOCUMENT, not just the vehicle and the field. The content
// root is the hash of the canonical passport payload, so a field commitment is
// by construction about one (vehicle, field, document) and not merely about a
// vehicle. That is what makes the binding checkable by someone who was handed
// the document: recompute this with the root you hold, and a claim about a
// different document gives a different slot. Before, a claim named the vehicle
// but nothing tied it to the payload a verifier was reading.
//
// The root is never taken as an argument. Every caller reads it from
// `passports`, so there is no version for a caller to choose.
//
// Exported for that off-chain check. The tag is v2 because the derivation
// changed: slots written under the previous scheme are a different set, which a
// fresh deployment makes moot.
//
// CONSEQUENCE, stated rather than discovered later: a passport's root is fixed
// when it is registered, so this is stable today. If revising a document is
// ever supported, every slot moves with the root and the earlier field history
// belongs to the earlier document. That is the honest meaning of binding, not
// a defect of it.
export circuit slotOf(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  contentRoot: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "vinpassport:field:v2"), vinHash, fieldKey, contentRoot]
  );
}

// A registrar's public identity, derived from a secret only that registrar
// holds. Identity is DERIVED, never supplied: a caller proves they hold the
// secret rather than naming who they are, so the name on a passport is a
// consequence of the proof instead of an argument to it.
//
// Domain-separated on its own tag, so a registrar identity can never collide
// with a field slot or a claim key.
export circuit registrarIdOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "vinpassport:registrar:v1"), secret]
  );
}

// Where a (vehicle, writer) pair lives in `writers`. Domain-separated on its
// own tag, so an authorisation can never be confused with a field slot, a
// claim key or a registrar identity.
//
// Exported because the party being authorised needs to compute it to check
// they really were, and a verifier needs it to ask whether a given identity
// may write to a given vehicle. Both are public questions about public state.
export circuit writerKeyOf(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "vinpassport:writer:v1"), vinHash, writerId]
  );
}

// A claim's public name. Binds the direction, the slot, the bound AND the
// commitment, so proving "at most 0" and "at least 0" are different claims,
// and neither survives the value being updated.
circuit claimKey(
  tag: Bytes<32>,
  slot: Bytes<32>,
  bound: Uint<64>,
  commitment: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [tag, slot, bound as Bytes<32>, commitment]
  );
}

// Who the caller is, checked against everyone entitled to write this vehicle,
// and returned so the write can be stamped with it.
//
// Both sides of the test are evaluated every time, as a circuit must: there is
// no short cut here and no branch for an observer to time. The registrar
// itself is never in `writers`, so the comparison against `registrar` is not
// redundant with the membership test.
//
// The identity is disclosed because the ledger records it. The secret behind
// it is not, and never leaves the circuit.
circuit writerFor(vinHash: Bytes<32>): Bytes<32> {
  const id = disclose(registrarIdOf(registrarSecret()));
  assert(
    registrar.lookup(vinHash) == id || writers.member(writerKeyOf(vinHash, id)),
    "not the registrar for this vehicle, and not authorised to write it"
  );
  return id;
}

// ---------------------------------------------------------------- circuits

// Register a vehicle passport. The content root commits to the canonical
// 32-field payload held off-chain; only its hash is public.
export circuit registerPassport(
  vinHash: Bytes<32>,
  contentRoot: Bytes<32>
): [] {
  assert(!passports.member(disclose(vinHash)), "passport already registered");

  // Disclosed because the ledger records WHICH authority registered the
  // vehicle, so a later claim is attributable. The secret behind it is not
  // disclosed and never leaves the circuit.
  const id = disclose(registrarIdOf(registrarSecret()));
  assert(allowedRegistrars.member(id), "not an authorised registrar");

  passports.insert(disclose(vinHash), disclose(contentRoot));
  registrar.insert(disclose(vinHash), id);
}

// Let another identity write this vehicle's fields. Only the registrar that
// registered the vehicle may do this, and only for that vehicle.
//
// `writerId` is the identity the other party derived from their own secret and
// handed over out of band. Nothing here can check it was derived that way, and
// nothing needs to: an identity nobody holds the secret for is an
// authorisation that can never be used, which costs one transaction and harms
// no one.
//
// AUTHORISING IS NOT THE WHOLE HANDOVER. Updating a field also requires the
// current value and its salt, and those are private state the registrar holds.
// A dealership that has been authorised but not handed the opening can create
// fields that do not exist yet; to update one it must be given the value it is
// updating, which is a disclosure the registrar makes deliberately and
// separately. The contract cannot do that part and does not pretend to.
export circuit authoriseWriter(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  assert(
    registrar.lookup(disclose(vinHash)) == registrarIdOf(registrarSecret()),
    "not the registrar for this vehicle"
  );
  assert(
    registrar.lookup(disclose(vinHash)) != disclose(writerId),
    "the registrar already writes this vehicle"
  );
  writers.insert(writerKeyOf(disclose(vinHash), disclose(writerId)));
}

// Take that permission away. A dealer relationship ends, a garage closes, a
// secret is suspected lost.
//
// What this does NOT do is unwrite anything. Fields that identity already
// wrote stay written and stay stamped with it, which is the honest behaviour:
// the record says who wrote what at the time, and withdrawing an authorisation
// afterwards cannot make that untrue.
export circuit withdrawWriter(
  vinHash: Bytes<32>,
  writerId: Bytes<32>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");
  assert(
    registrar.lookup(disclose(vinHash)) == registrarIdOf(registrarSecret()),
    "not the registrar for this vehicle"
  );
  const key = writerKeyOf(disclose(vinHash), disclose(writerId));
  assert(writers.member(key), "not a writer for this vehicle");
  writers.remove(key);
}

// Create a field and fix its integrity rule for good. The opening value is a
// witness, so the field exists on chain without its value being published.
export circuit initialiseField(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  rule: Rule
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  // The registrar for this vehicle, or an identity it authorised. The caller
  // proves they hold the secret behind one of those identities; the identity
  // itself is recorded against the field below.
  const writer = writerFor(disclose(vinHash));

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(!fieldCommitment.member(slot), "field already initialised");

  const value = newValue();
  fieldCommitment.insert(slot, persistentCommit<Uint<64>>(value, newSalt()));
  fieldRule.insert(slot, disclose(rule));
  fieldWriter.insert(slot, writer);
  updateCount.increment(1);
}

// Write a new value for a field, proving in-circuit that the caller knows the
// current one and that the change respects the rule fixed at creation.
// Neither value is disclosed.
export circuit recordField(vinHash: Bytes<32>, fieldKey: Bytes<32>): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  // Same gate as creation: history is written by the registrar for this
  // vehicle or by someone it authorised. Proving a claim about a field stays
  // open to anyone who can open its commitment, which is a separate right and
  // deliberately ungated.
  const writer = writerFor(disclose(vinHash));

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const prev = previousValue();
  const prevSalt = previousSalt();

  // The caller must genuinely know the current value: its commitment has to
  // reproduce what the ledger already holds.
  assert(
    persistentCommit<Uint<64>>(prev, prevSalt) == fieldCommitment.lookup(slot),
    "previous value does not open the stored commitment"
  );

  const current = newValue();
  const rule = fieldRule.lookup(slot);

  // All three guards are evaluated every time; each is vacuous under the
  // other rules. Written this way rather than as a branch so that the failure
  // a caller sees names what they violated.
  assert(rule != Rule.neverFalls || current >= prev, "value decreased");
  assert(rule != Rule.neverRises || current <= prev, "value increased");
  assert(rule != Rule.neverChanges || current == prev, "value changed");

  fieldCommitment.insert(slot, persistentCommit<Uint<64>>(current, newSalt()));
  fieldWriter.insert(slot, writer);
  updateCount.increment(1);
}

// Prove the hidden value is at or below a public bound.
// "Under 150 000 km." "Never had a reported accident" is this with bound 0.
export circuit proveFieldAtMost(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  // Reading the root means the passport has to exist. Proving a claim about an
  // unregistered vehicle was never possible, because no field could have been
  // initialised for one, but it now refuses for the reason a caller expects
  // rather than for a reason about slots.
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value <= disclose(bound), "value above the claimed bound");

  // Only reached when the claim holds: a failed proof aborts above and writes
  // nothing.
  claims.insert(
    claimKey(pad(32, "vinpassport:claim:atmost:v1"), slot, disclose(bound), commitment),
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: true
    }
  );
}

// Prove the hidden value is at or above a public bound.
// The mirror of proveFieldAtMost: a floor rather than a ceiling.
export circuit proveFieldAtLeast(
  vinHash: Bytes<32>,
  fieldKey: Bytes<32>,
  bound: Uint<64>
): [] {
  assert(passports.member(disclose(vinHash)), "unknown passport");

  const slot = slotOf(
    disclose(vinHash), disclose(fieldKey), passports.lookup(disclose(vinHash))
  );
  assert(fieldCommitment.member(slot), "field not initialised");

  const value = previousValue();
  const salt = previousSalt();
  const commitment = fieldCommitment.lookup(slot);

  assert(
    persistentCommit<Uint<64>>(value, salt) == commitment,
    "value does not open the stored commitment"
  );

  assert(value >= disclose(bound), "value below the claimed bound");

  claims.insert(
    claimKey(pad(32, "vinpassport:claim:atleast:v1"), slot, disclose(bound), commitment),
    Claim {
      slot: slot,
      vinHash: disclose(vinHash),
      fieldKey: disclose(fieldKey),
      commitment: commitment,
      bound: disclose(bound),
      atMost: false
    }
  );
}
